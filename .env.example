# JARVIS Ultimate AI — backend configuration.
# Copy to backend/.env (or export in your shell / service manager). NEVER commit the real file.

# --- core -------------------------------------------------------------------
JARVIS_ENV=development                 # development | production
# Required in production. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JARVIS_SECRET_KEY=change-me-change-me-change-me-change-me
JARVIS_DATABASE_PATH=jarvis.db
JARVIS_DEFAULT_TIMEZONE=Asia/Kolkata
JARVIS_ALLOW_REGISTRATION=false        # the first account can always be created; others only if true
# JARVIS_CORS_ORIGINS=                 # only if a client on another origin needs the API

# --- AI provider (switch without code changes) ------------------------------
# local-rules        : no AI, offline simple commands (default; good for testing the pipeline)
# anthropic          : Claude via the Anthropic Messages API
# openai-compatible  : OpenAI, Groq, OpenRouter, Together, a local Ollama / LM Studio, ...
JARVIS_LLM_PROVIDER=local-rules
# The model name is required for real providers and is never hardcoded. Use the current
# model name from your provider's docs, e.g. a Claude model id from docs.claude.com.
JARVIS_LLM_MODEL=
JARVIS_LLM_API_KEY=
# For openai-compatible only, e.g. https://api.openai.com/v1 or http://localhost:11434/v1 (Ollama, free & local)
JARVIS_LLM_BASE_URL=
JARVIS_LLM_TIMEOUT_S=60
JARVIS_LLM_MAX_RETRIES=2
JARVIS_LLM_MAX_TOKENS=1024

# --- web search ---------------------------------------------------------------
JARVIS_SEARCH_PROVIDER=none            # none | brave | tavily
JARVIS_SEARCH_API_KEY=
JARVIS_SEARCH_TIMEOUT_S=15

# --- devices ----------------------------------------------------------------------
JARVIS_DEVICE_WAIT_S=20                # how long a chat waits for a phone/PC to report a result
JARVIS_TOOL_TIMEOUT_S=20
