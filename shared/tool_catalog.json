      "type": "object"
    }
  },
  {
    "name": "desktop_create_note",
    "target": "desktop",
    "permission": "device.desktop",
    "confirmation": false,
    "description": "Create a new text note on the Windows computer (never overwrites).",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "maxLength": 100,
          "minLength": 1,
