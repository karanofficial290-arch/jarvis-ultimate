  {
    "name": "android_draft_sms",
    "target": "android",
    "permission": "device.android",
    "confirmation": true,
    "description": "Open the SMS composer with a drafted message. The user still presses Send.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "phone_number": {
          "anyOf": [
            {
              "pattern": "^\\+?[0-9 ()-]{3,20}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phone Number"
        },
        "body": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        }
      },
      "required": [
        "body"
      ],
      "type": "object"
    }
  },
